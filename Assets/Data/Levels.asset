    levels:
    - number: 1
      title: First Day Home
      month: 0
      objective: Feed, burp, change and settle the baby, and get through to tomorrow
        morning.
      briefing: Your first full day at home together. The baby will tell you what
        they need - watch the need icons and the body language. Get through to 07:00
        tomorrow without too much crying.
      failHint: Feed the baby when the hunger icon turns into a triangle, before
        the crying starts.
      tutorial: 1
      startHour: 7
      lengthMinutes: 1440
      cryingBudgetMinutes: 180
      maxContinuousCryMinutes: 30
      allowance: 0
      helpCalls: 1
      goals:
      - type: 0
        target: 1
        text: Feed the baby
      - type: 1
        target: 1
        text: Burp after a feed
      - type: 2
        target: 1
        text: Change a diaper
      - type: 3
        target: 1
        text: Put the baby to sleep
      failConditions: []
      actions: 0100000002000000030000000400000005000000060000000700000008000000090000000a0000000b0000000c0000000d000000
