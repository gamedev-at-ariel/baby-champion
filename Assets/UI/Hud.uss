/* Baby Champion HUD (M2 greybox). Reference resolution 1280x720, matched on height. */

.hud {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: rgb(40, 34, 44);
    font-size: 18px;
}

.panel {
    background-color: rgba(255, 250, 242, 0.92);
    border-radius: 14px;
    padding: 8px 12px;
    border-width: 2px;
    border-color: rgba(120, 96, 80, 0.35);
}

.row { flex-direction: row; align-items: center; }

/* ---------------------------------------------------------------- top-left: clock */
.clock-panel { position: absolute; left: 12px; top: 10px; width: 270px; }
.clock { font-size: 34px; -unity-font-style: bold; }
.objective { font-size: 15px; color: rgb(90, 80, 90); white-space: normal; }
.speed { font-size: 15px; color: rgb(60, 90, 160); -unity-font-style: bold; }

/* ---------------------------------------------------------------- top-center: baby needs */
.needs { position: absolute; top: 10px; left: 300px; right: 300px; flex-direction: row; justify-content: center; }
.need { width: 78px; align-items: center; margin: 0 3px; }
.need-shape { width: 54px; height: 54px; justify-content: center; align-items: center; }
.need-mark { font-size: 22px; -unity-font-style: bold; color: rgb(255, 255, 255); -unity-text-align: middle-center; }
.need-name { font-size: 14px; -unity-text-align: middle-center; -unity-font-style: bold; }
.need-bar { width: 58px; height: 6px; background-color: rgba(60, 50, 60, 0.25); border-radius: 3px; overflow: hidden; }
.need-bar-fill { height: 100%; background-color: rgb(90, 80, 100); }

/* ---------------------------------------------------------------- top-right: money, supplies, buttons */
.top-right { position: absolute; right: 12px; top: 10px; align-items: flex-end; }
.money { font-size: 24px; -unity-font-style: bold; margin-right: 8px; }
.icon-button {
    min-width: 92px; height: 64px; margin-left: 8px;
    font-size: 18px; -unity-font-style: bold;
    border-radius: 14px; border-width: 2px;
    background-color: rgb(255, 236, 205); border-color: rgb(200, 150, 110);
}
.supplies { margin-top: 8px; width: 210px; }
.supply { font-size: 16px; }
.supply--low { color: rgb(200, 50, 40); -unity-font-style: bold; }
.delivery { font-size: 14px; color: rgb(60, 110, 60); white-space: normal; }

/* ---------------------------------------------------------------- bottom-left: parent */
.parent-panel { position: absolute; left: 12px; bottom: 12px; width: 330px; flex-direction: row; align-items: center; }
.portrait {
    width: 70px; height: 70px; border-radius: 35px; margin-right: 10px;
    background-color: rgb(120, 160, 210); border-width: 4px; border-color: rgba(255, 200, 60, 0.5);
    justify-content: center; align-items: center;
}
.portrait-label { color: white; -unity-font-style: bold; font-size: 18px; }
.bars { flex-grow: 1; }
.bar-row { flex-direction: row; align-items: center; margin: 2px 0; }
.bar-name { width: 62px; font-size: 15px; }
.bar { flex-grow: 1; height: 16px; background-color: rgba(60, 50, 60, 0.2); border-radius: 8px; overflow: hidden; }
.bar-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: rgb(100, 190, 100); }
.bar-mark { position: absolute; top: 0; bottom: 0; width: 2px; background-color: rgba(40, 30, 40, 0.8); }
.bar-value { width: 34px; font-size: 14px; -unity-text-align: middle-right; }

/* ---------------------------------------------------------------- bottom-center: current action */
.action-panel { position: absolute; bottom: 12px; left: 360px; right: 360px; align-items: center; flex-direction: row; justify-content: center; }
.action-text { font-size: 18px; flex-shrink: 1; white-space: normal; }
.action-progress { width: 140px; height: 10px; margin: 0 10px; background-color: rgba(60, 50, 60, 0.2); border-radius: 5px; overflow: hidden; }
.action-progress-fill { height: 100%; background-color: rgb(90, 140, 220); }
.stop-button { min-width: 96px; height: 60px; font-size: 18px; -unity-font-style: bold; border-radius: 12px; background-color: rgb(250, 210, 200); }

/* ---------------------------------------------------------------- bottom-right: events and toasts */
.ticker { position: absolute; right: 12px; bottom: 12px; width: 300px; align-items: flex-end; }
.ticker-line { font-size: 14px; background-color: rgba(255, 250, 242, 0.85); border-radius: 6px; padding: 2px 6px; margin-top: 3px; white-space: normal; }
.toasts { position: absolute; top: 110px; left: 300px; right: 300px; align-items: center; }
.toast { font-size: 18px; background-color: rgba(60, 40, 50, 0.88); color: white; border-radius: 10px; padding: 6px 14px; margin-top: 6px; -unity-font-style: bold; white-space: normal; }

/* ---------------------------------------------------------------- radial menu */
.radial-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(30, 20, 30, 0.18); }
.radial-title {
    position: absolute; width: 140px; height: 44px; font-size: 18px; -unity-font-style: bold;
    -unity-text-align: middle-center; background-color: rgba(255, 250, 242, 0.95); border-radius: 22px;
}
.radial-button {
    position: absolute; width: 140px; height: 84px; margin: 0; padding: 4px;
    border-radius: 18px; border-width: 3px; border-color: rgb(200, 150, 110);
    background-color: rgb(255, 244, 228); justify-content: center; align-items: center;
}
.radial-button:hover { background-color: rgb(255, 230, 190); }
.radial-button:disabled { background-color: rgb(225, 222, 220); border-color: rgb(180, 176, 172); opacity: 1; }
.radial-label { font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.radial-reason { font-size: 12px; color: rgb(120, 90, 90); -unity-text-align: middle-center; white-space: normal; }
.radial-button:disabled .radial-label { color: rgb(140, 136, 134); }

/* ---------------------------------------------------------------- modal panels */
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(30, 20, 30, 0.45); justify-content: center; align-items: center; }
.modal { background-color: rgb(255, 250, 242); border-radius: 18px; padding: 16px 20px; min-width: 520px; max-width: 900px; }
.modal-title { font-size: 26px; -unity-font-style: bold; margin-bottom: 8px; white-space: normal; }
.modal-text { font-size: 17px; margin-bottom: 4px; white-space: normal; }
.modal-button { min-width: 120px; height: 60px; font-size: 18px; -unity-font-style: bold; border-radius: 12px; margin: 4px; }
.modal-button--selected { background-color: rgb(255, 214, 150); border-color: rgb(200, 140, 60); }
.order-row { flex-direction: row; align-items: center; margin: 3px 0; }
.order-name { width: 190px; font-size: 18px; }

/* ---------------------------------------------------------------- edge indicators */
.edge { position: absolute; width: 96px; height: 70px; margin-left: -48px; margin-top: -35px; align-items: center; justify-content: center; }
.edge-arrow { position: absolute; width: 70px; height: 70px; }
.edge-label { font-size: 14px; -unity-font-style: bold; color: white; background-color: rgba(200, 60, 50, 0.92); border-radius: 8px; padding: 2px 6px; }
.edge--delivery .edge-label { background-color: rgba(50, 130, 70, 0.92); }

/* ---------------------------------------------------------------- name tags over the 3-D view */
.tags { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.tag {
    position: absolute; translate: -50% -100%;
    font-size: 15px; color: rgb(60, 50, 60); -unity-text-align: middle-center;
    background-color: rgba(255, 252, 245, 0.82); border-radius: 8px; padding: 1px 7px;
    border-width: 1px; border-color: rgba(120, 96, 80, 0.4);
}
.tag--baby { font-size: 18px; -unity-font-style: bold; background-color: rgb(255, 230, 110); border-color: rgb(200, 160, 40); }
.tag--crying { background-color: rgb(225, 70, 60); color: rgb(255, 255, 255); border-color: rgb(150, 30, 30); }
.tag--you { font-size: 15px; -unity-font-style: bold; background-color: rgb(70, 115, 205); color: rgb(255, 255, 255); border-color: rgb(40, 70, 140); }
